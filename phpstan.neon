includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    level: 9
    paths:
        - src
        - tests
    tmpDir: .phpstan.cache
    ignoreErrors:
        # PHPUnit's own convention is $this->assertSame(); keep the strict rule for src only.
        -
            identifier: staticMethod.dynamicCall
            paths:
                - tests/*

{
    "name": "laragod/phpskills",
    "description": "TrueSkill and Elo rating calculators for PHP. A typed, tested PHP 8 port of Microsoft's TrueSkill algorithm (via Moserware.Skills).",
    "keywords": [
        "trueskill",
        "elo",
        "matchmaking",
        "ranking",
        "rating",
        "skill",
        "bayesian",
        "leaderboard"
    ],
    "homepage": "https://github.com/laragod/PHPSkills",
    "license": "BSD-2-Clause",
    "authors": [
        {
            "name": "Jeff Moser",
            "email": "jeff@moserware.com",
            "role": "Original author"
        },
        {
            "name": "Alexander Liljengård",
            "email": "alexander@paxxmedia.se",
            "role": "Contributor"
        },
        {
            "name": "Filip Cieślik",
            "email": "filipjancieslik@gmail.com",
            "homepage": "https://laragod.com",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/laragod/PHPSkills/issues",
        "source": "https://github.com/laragod/PHPSkills"
    },
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "laravel/pint": "^1.25",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Laragod\\Skills\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Laragod\\Skills\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=1G",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ],
        "lint": "pint --test",
        "lint:fix": "pint",
        "refactor": "rector process --dry-run",
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text --coverage-clover=coverage.xml"
    },
    "scripts-descriptions": {
        "analyse": "Run PHPStan static analysis",
        "check": "Run the code style check, static analysis and the test suite",
        "lint": "Check code style with Pint",
        "lint:fix": "Fix code style with Pint",
        "refactor": "Show what Rector would change",
        "test": "Run the test suite",
        "test:coverage": "Run the test suite with a coverage report"
    }
}
